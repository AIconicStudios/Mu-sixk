{
  "name": "mu-sixk",
  "version": "0.1.0",
  "description": "Free mix feedback: measures your audio and tells you what to fix, and by how much.",
  "author": "AIconic Studios",
  "private": true,
  "license": "MIT",
  "main": "desktop/main.js",
  "scripts": {
    "build": "node build.js",
    "test": "node --test",
    "desktop": "electron .",
    "dist:win": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "studio.aiconic.musixk",
    "productName": "Mu-sixk",
    "files": ["index.html", "desktop/main.js", "package.json"],
    "directories": { "output": "release" },
    "win": { "target": ["nsis", "portable"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "artifactName": "Mu-sixk-Setup-${version}.exe" },
    "portable": { "artifactName": "Mu-sixk-Portable-${version}.exe" }
  }
}
